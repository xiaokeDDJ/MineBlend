{
  "schemaVersion": 1,
  "id": "mineblend",
  "version": "${version}",
  "name": "MineBlend",
  "description": "MineBlend：把正在运行的 Minecraft 世界实时导入 Blender（选区棒 + 本地接口）",
  "authors": ["MineBlend contributors"],
  "license": "GPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": ["mineblend.MineBlend"],
    "client": ["mineblend.MineBlendClient"]
  },
  "mixins": ["mineblend.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}
